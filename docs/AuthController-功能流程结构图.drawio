<mxfile host="app.diagrams.net" type="device">
  <diagram name="AuthController流程图" id="auth-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="开始 · 认证请求" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="470" y="30" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="请求类型 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="470" y="120" width="160" height="90" as="geometry" />
        </mxCell>

        <!-- 登录列 -->
        <mxCell id="io1" value="LoginDTO&#10;username · password" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="250" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="校验用户名 / 密码" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="350" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="凭证是否有效 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="450" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="err" value="返回错误&#10;(账号/密码不正确)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="150" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="签发 token · 更新 lastLoginAt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="210" y="590" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="vo1" value="LoginVO 输出&#10;token + UserVO" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="215" y="700" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- profile 列 -->
        <mxCell id="d3" value="token 是否有效 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="480" y="250" width="180" height="90" as="geometry" />
        </mxCell>
        <mxCell id="err2" value="401 未认证" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="700" y="265" width="140" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="按上下文取当前用户" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="490" y="390" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vo2" value="UserVO 输出&#10;(含角色码/权限)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="490" y="700" width="190" height="55" as="geometry" />
        </mxCell>

        <!-- logout 列 -->
        <mxCell id="p4" value="占位返回&#10;(前端清 token)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="780" y="450" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- 数据表 -->
        <mxCell id="db" value="sys.sys_user&#10;用户实体表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="320" y="455" width="160" height="75" as="geometry" />
        </mxCell>

        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="500" y="830" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- 连线 -->
        <mxCell id="e_s_d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_io1" value="登录 login" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="io1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_d3" value="当前用户 profile" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p4" value="登出 logout" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="165" /></Array></mxGeometry></mxCell>
        <mxCell id="e_io1_p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="io1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p1_d2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p1" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p1_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p1" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d2_err" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="err"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d2_p2" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p2_vo1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p2" target="vo1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d3_err2" value="否" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="err2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d3_p3" value="是" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d3" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p3_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p3" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p3_vo2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="vo2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="575" y="600" /></Array></mxGeometry></mxCell>
        <mxCell id="e_vo1_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vo1" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_vo2_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vo2" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p4_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p4" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="855" /></Array></mxGeometry></mxCell>
        <mxCell id="e_err_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="err" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="855" /></Array></mxGeometry></mxCell>
        <mxCell id="e_err2_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="err2" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
