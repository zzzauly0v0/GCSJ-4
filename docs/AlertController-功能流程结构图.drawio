        </mxCell>
        <mxCell id="q3" value="latest(limit) 最新 N 条 (大屏滚动)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="1720" width="230" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q4" value="asGeoJson() GeoJSON (地图标注)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="310" y="1720" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- VO 输出 (平行四边形) -->
        <mxCell id="vo" value="AlertVO 输出&#10;等级标签/颜色 · 事件code · channels拆分" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="300" y="1830" width="260" height="60" as="geometry" />
        </mxCell>

        <!-- 结束 -->
        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="375" y="1940" width="110" height="50" as="geometry" />
        </mxCell>

        <!-- ===== 连线 ===== -->
        <mxCell id="e_start_d1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_io1" value="manual 手动" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="io1"><mxGeometry relative="1" as="geometry" /></mxCell>
