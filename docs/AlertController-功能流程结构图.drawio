<mxfile host="app.diagrams.net" type="device">
  <diagram name="AlertController流程图" id="alert-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="2400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始 -->
        <mxCell id="start" value="开始 · 发起预警" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="340" y="40" width="170" height="50" as="geometry" />
        </mxCell>

        <!-- 判断: 创建来源 -->
        <mxCell id="d1" value="创建来源 source ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="335" y="130" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- 手动入参 (平行四边形) -->
        <mxCell id="io1" value="手动入参&#10;CreateAlertDTO" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="120" y="250" width="180" height="60" as="geometry" />
        </mxCell>

        <!-- 灾害事件 (圆柱) -->
        <mxCell id="ev" value="灾害事件 Event" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="560" y="245" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- createFromEvent 处理 -->
        <mxCell id="p0" value="createFromEvent&#10;自动取事件 location / level" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="345" width="160" height="60" as="geometry" />
        </mxCell>

        <!-- Service 落库 -->
        <mxCell id="p1" value="IAlertService&#10;生成 code · 落库 · status=1(触发)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="320" y="360" width="210" height="60" as="geometry" />
        </mxCell>

        <!-- 实体表 (圆柱) -->
        <mxCell id="db" value="biz.biz_alert&#10;预警实体表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="345" y="460" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- 判断: 是否配置通道 -->
        <mxCell id="d2" value="是否配置&#10;推送通道 channels ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="570" width="210" height="100" as="geometry" />
        </mxCell>

        <!-- 触发分发 -->
        <mxCell id="p2" value="触发分发事件 · 按通道推送" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="320" y="710" width="210" height="50" as="geometry" />
        </mxCell>

        <!-- 判断: 通道类型 -->
        <mxCell id="d3" value="通道类型 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="345" y="800" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="站内 in_site" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="815" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="短信 sms" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="120" y="880" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="邮件 email" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="815" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- 记录 sentAt -->
        <mxCell id="p3" value="记录 sentAt" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="345" y="950" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- status=1 触发态 (圆角) -->
        <mxCell id="s1" value="status=1 触发" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="345" y="1040" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- 判断: 运维处理动作 -->
        <mxCell id="d4" value="运维处理动作 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="335" y="1130" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- confirm 处理 -->
        <mxCell id="p4" value="记录 confirmedAt / confirmedById&#10;status → 已确认" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="110" y="1255" width="220" height="60" as="geometry" />
        </mxCell>

        <!-- 判断: 是否关闭 -->
        <mxCell id="d5" value="是否关闭 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="130" y="1350" width="170" height="90" as="geometry" />
        </mxCell>

        <!-- close 处理 -->
        <mxCell id="p5" value="status → 已关闭" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="540" y="1265" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- 判断: 查询/展示场景 -->
        <mxCell id="d6" value="查询 / 展示场景 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="1500" width="210" height="110" as="geometry" />
        </mxCell>

        <mxCell id="q1" value="page(keyword,level,status,eventId)&#10;分页列表" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
