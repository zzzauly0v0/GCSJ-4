<mxfile host="app.diagrams.net" type="device">
  <diagram name="ReplayController流程图" id="replay-flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- 开始 -->
        <mxCell id="start" value="开始 · 前端时间轴拖动" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="510" y="40" width="200" height="50" as="geometry" />
        </mxCell>

        <!-- window 处理 -->
        <mxCell id="init" value="window()&#10;读取窗口元信息" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="510" y="120" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- 元数据来源 (圆柱) -->
        <mxCell id="meta" value="biz.biz_weather_observation&#10;(MIN/MAX observed_at)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="e-meta-init" style="endArrow=classic;html=1;" edge="1" parent="1" source="meta" target="init">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- window 输出 -->
        <mxCell id="out0" value="WindowVO&#10;startAt / endAt / description" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="510" y="210" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e-init-out0" style="endArrow=classic;html=1;" edge="1" parent="1" source="init" target="out0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 主入口判断 -->
        <mxCell id="d1" value="前端动作类型 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
