<mxfile host="app.diagrams.net" type="device">
  <diagram name="UserController流程图" id="user-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="开始 · 用户管理请求" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="420" y="40" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="d1" value="操作类型 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="430" y="130" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="io1" value="CreateUserDTO" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="135" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="io2" value="UpdateUserDTO" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="60" y="210" width="160" height="50" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="校验唯一用户名 · 密码加密&#10;分配 roleIds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="更新资料 / 状态 / 角色" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="320" y="300" width="180" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="置 deleted=true (软删)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="540" y="300" width="180" height="55" as="geometry" />
        </mxCell>

        <mxCell id="db" value="sys.sys_user&#10;用户实体表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="410" y="430" width="180" height="75" as="geometry" />
        </mxCell>

        <mxCell id="d2" value="查询场景 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="430" y="560" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="q1" value="page(keyword) 分页" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="250" y="690" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="q2" value="get(id) 详情" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="560" y="690" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="role" value="角色 / 权限&#10;roleCodes · permissions" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="780" width="180" height="75" as="geometry" />
        </mxCell>

        <mxCell id="vo" value="UserVO 输出&#10;(含角色码与权限列表)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="380" y="790" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="445" y="920" width="110" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e_s_d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p1" value="创建 create" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p2" value="更新 update" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p3" value="软删 delete" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_d2" value="查询" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="540" /></Array></mxGeometry></mxCell>
        <mxCell id="e_io1_p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="io1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_io2_p2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="io2" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p1_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p1" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p2_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p2" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p3_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db_d2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="db" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d2_q1" value="分页列表" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d2_q2" value="单条详情" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d2" target="q2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_q1_vo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="q1" target="vo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_q2_vo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="q2" target="vo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_role_vo" value="关联装配" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="role" target="vo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_vo_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vo" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
