        <mxCell id="db" value="gis.gis_layer&#10;图层实体表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="430" y="450" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="gis" value="source_url 指向&#10;GisData GeoJSON" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="760" y="450" width="190" height="75" as="geometry" />
        </mxCell>
        <mxCell id="vo" value="LayerVO 输出&#10;(数据源/样式/层级/可见性)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="400" y="580" width="250" height="60" as="geometry" />
