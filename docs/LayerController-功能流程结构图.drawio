        </mxCell>
        <mxCell id="io1" value="CreateLayerDTO&#10;type: vector/raster/wms/wmts/xyz" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
