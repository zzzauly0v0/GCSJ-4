        </mxCell>
        <mxCell id="p2" value="更新图层" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="620" y="300" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="删除图层" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="770" y="300" width="120" height="45" as="geometry" />
