<mxfile host="app.diagrams.net" type="device">
  <diagram name="OperationLogController流程图" id="log-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="950" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="src" value="业务请求触发&#10;(切面/拦截器自动记录)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="600" y="120" width="220" height="55" as="geometry" />
        </mxCell>
        <mxCell id="db" value="sys.sys_operation_log&#10;操作日志表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="380" y="540" width="200" height="75" as="geometry" />
        </mxCell>

        <mxCell id="start" value="开始 · GET /api/logs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="120" y="40" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="io" value="过滤条件&#10;username·method·uri·from·to·分页" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="100" y="130" width="250" height="55" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="是否带过滤条件 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="130" y="240" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="按条件 + 时间区间过滤" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="全量" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="250" y="380" width="120" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="按 createdAt 倒序 · 分页" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="130" y="460" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="vo" value="PageResult&lt;OperationLogVO&gt; 输出" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="350" y="660" width="270" height="55" as="geometry" />
        </mxCell>
        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="770" width="110" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e_src_db" value="写入" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="src" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_s_io" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="io"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_io_d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="io" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p1" value="有条件" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p2" value="无条件" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p1_p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p1" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p2_p3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p3_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db_vo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="db" target="vo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_vo_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vo" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
