        </mxCell>
        <mxCell id="r6" value="取全部居民点" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="980" y="400" width="130" height="45" as="geometry" />
        </mxCell>

        <mxCell id="db" value="gis 空间数据&#10;(行政区/河流/居民点)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="480" y="520" width="220" height="75" as="geometry" />
        </mxCell>
        <mxCell id="p" value="转换为 GeoJSON FeatureCollection" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="470" y="640" width="240" height="45" as="geometry" />
        </mxCell>
        <mxCell id="vo" value="Map&lt;String,Object&gt; 输出 · GeoJSON" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="460" y="720" width="260" height="55" as="geometry" />
        </mxCell>
        <mxCell id="end" value="结束 · 供前端地图渲染" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
