        </mxCell>
        <mxCell id="io1" value="CreateDictionaryDTO" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="880" y="120" width="190" height="50" as="geometry" />
        </mxCell>

