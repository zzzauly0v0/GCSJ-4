<mxfile host="app.diagrams.net" type="device">
  <diagram name="RoleController流程图" id="role-flow">
    <mxGraphModel dx="1100" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="开始 · 角色管理请求" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="430" y="40" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="操作类型 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="160" height="90" as="geometry" />
        </mxCell>

        <mxCell id="io1" value="CreateRoleDTO&#10;name·code·permissionIds" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="135" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="q1" value="listAll() 全部角色" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="300" y="290" width="170" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="创建角色 · 绑定 permissionIds" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="60" y="290" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="更新角色 · 重绑权限" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="500" y="290" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="删除角色" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="710" y="290" width="140" height="50" as="geometry" />
        </mxCell>

        <mxCell id="db" value="sys.sys_role&#10;角色实体表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="330" y="420" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rel" value="角色-权限关联表" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="170" height="70" as="geometry" />
        </mxCell>

        <mxCell id="vo" value="RoleVO 输出&#10;(含 permissionIds)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="290" y="580" width="240" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end" value="结束" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="500" y="700" width="110" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e_s_d1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="start" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_q1" value="全部 list" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p1" value="新增 create" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p2" value="更新 update" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_d1_p3" value="删除 delete" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="d1" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_io1_p1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="io1" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p1_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p1" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p2_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p2" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p3_db" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p1_rel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p1" target="rel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p2_rel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="p2" target="rel"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db_q1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="db" target="q1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_q1_vo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="q1" target="vo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_db_vo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="db" target="vo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_vo_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="vo" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_p3_end" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="p3" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="780" y="725" /></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
